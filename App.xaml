<Application x:Class="Wincy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Wincy"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:AppIconConverter x:Key="AppIconConverter" />
        <local:ImageToVisibilityConverter x:Key="ImageToVisibilityConverter" />
        <local:TextToVisibilityConverter x:Key="TextToVisibilityConverter" />
    </Application.Resources>
</Application>