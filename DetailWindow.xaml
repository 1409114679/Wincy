<Window x:Class="Wincy.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False">
    <Border Background="#1E1E1E"
            BorderBrush="#555555"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="0,0,4,0">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Resources>
                        <!-- Hide arrow buttons -->
                        <Style TargetType="RepeatButton">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                        <!-- Custom thumb with 6px width and transparent rounded style -->
                        <Style TargetType="Thumb">
                            <Setter Property="MinWidth" Value="6"/>
                            <Setter Property="MaxWidth" Value="6"/>
                            <Setter Property="MinHeight" Value="20"/>
                            <Setter Property="Background" Value="#33FFFFFF"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3"
                                                Background="{TemplateBinding Background}"
                                                Width="{TemplateBinding MinWidth}"
                                                MinHeight="{TemplateBinding MinHeight}"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Style.Resources>
                </Style>
            </ScrollViewer.Resources>
            <Grid>
                <TextBlock x:Name="DetailTextBlock"
                           Foreground="#CCCCCC"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <Image x:Name="DetailImageView"
                       Stretch="Uniform"
                       StretchDirection="Both"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>
    </Border>
</Window>