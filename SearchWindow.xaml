<Window x:Class="Wincy.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wincy"
        Width="250"
        Height="450"
        MinWidth="200"
        MinHeight="200"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated"
        MouseMove="Window_MouseMove"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Thin transparent scrollbar style (same as DetailWindow) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Resources>
                <!-- Hide arrow buttons -->
                <Style TargetType="RepeatButton">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
                <!-- Custom thumb with 6px width and transparent rounded style -->
                <Style TargetType="Thumb">
                    <Setter Property="MinWidth" Value="6"/>
                    <Setter Property="MaxWidth" Value="6"/>
                    <Setter Property="MinHeight" Value="20"/>
                    <Setter Property="Background" Value="#33FFFFFF"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Thumb">
                                <Border CornerRadius="3"
                                        Background="{TemplateBinding Background}"
                                        Width="{TemplateBinding MinWidth}"
                                        MinHeight="{TemplateBinding MinHeight}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="Button" x:Key="HeaderButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder"
            Background="#2D2D2D"
            BorderBrush="#555555"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Header: wincy | [search + 🔍] | ⚙ -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand: wincy -->
                <TextBlock Grid.Column="0"
                           Text="wincy"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <!-- Search Box with magnifying glass -->
                <Border Grid.Column="1"
                        Background="#3D3D3D"
                        CornerRadius="4"
                        Padding="6,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="0"
                                 Background="Transparent"
                                 Foreground="White"
                                 CaretBrush="White"
                                 BorderThickness="0"
                                 FontSize="13"
                                 Padding="0"
                                 VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalAlignment="Center" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <TextBlock Grid.Column="1"
                                   Text="🔍"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Opacity="0.5" />
                    </Grid>
                </Border>

                <!-- Settings gear -->
                <Button Grid.Column="2"
                        Content="⚙"
                        Style="{StaticResource HeaderButtonStyle}"
                        Margin="6,0,0,0"
                        Width="28"
                        Height="28"
                        Click="SettingsButton_Click"
                        ToolTip="Preferences" />
            </Grid>

            <!-- Row 1: Results List -->
            <ListBox x:Name="ResultsList"
                     Grid.Row="1"
                     Background="Transparent"
                     Foreground="White"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ResultsList_MouseDoubleClick"
                     MouseMove="ResultsList_MouseMove"
                     MouseLeave="ResultsList_MouseLeave"
                     PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp"
                     SelectionChanged="ResultsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="4,2" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0"
                                       Width="16" Height="16"
                                       VerticalAlignment="Center"
                                       Source="{Binding SourceAppPath, Converter={StaticResource AppIconConverter}}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <Grid Grid.Column="1" Margin="6,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0"
                                           Source="{Binding ThumbnailImage}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Left"
                                           MaxHeight="20"
                                           Visibility="{Binding HasImage, Converter={StaticResource ImageToVisibilityConverter}}" />

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Preview}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Visibility="{Binding HasImage, Converter={StaticResource TextToVisibilityConverter}}" />

                                    <TextBlock Grid.Column="1"
                                               Text="📌"
                                               FontSize="9"
                                               VerticalAlignment="Center"
                                               Margin="2,0,0,0"
                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="3"
                                            Padding="0">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#0078D4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Row 2: Footer -->
            <Border Grid.Row="2" Margin="0,4,0,0" Padding="3,1" Background="#333333" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               x:Name="FooterText"
                               Foreground="#888888"
                               FontSize="10"/>
                    <TextBlock x:Name="FooterShortcuts"
                               Grid.Column="1"
                               Foreground="#666666"
                               FontSize="9">
                        <Run Text="↵ Copy" />
                        <Run Text=" | " Foreground="#444444" />
                        <Run Text="⌥↵ Paste" Foreground="#666666" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>