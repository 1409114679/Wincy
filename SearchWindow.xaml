<Window x:Class="Wincy.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wincy"
        Width="500"
        Height="450"
        MinWidth="320"
        MinHeight="250"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Deactivated="Window_Deactivated"
        MouseMove="Window_MouseMove"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="Button" x:Key="HeaderButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder"
            Background="#2D2D2D"
            BorderBrush="#555555"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: Brand + Search Box + Settings -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand: wincy -->
                <TextBlock Grid.Column="0"
                           Text="wincy"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <!-- Search Box with magnifying glass indicator -->
                <Border Grid.Column="1"
                        Background="#3D3D3D"
                        CornerRadius="4"
                        Padding="6,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="0"
                                 Background="Transparent"
                                 Foreground="White"
                                 CaretBrush="White"
                                 BorderThickness="0"
                                 FontSize="13"
                                 Padding="0"
                                 VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalAlignment="Center" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>

                        <!-- Magnifying glass icon -->
                        <TextBlock Grid.Column="1"
                                   Text="🔍"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Opacity="0.5" />
                    </Grid>
                </Border>

                <!-- Settings gear button -->
                <Button Grid.Column="2"
                        Content="⚙"
                        Style="{StaticResource HeaderButtonStyle}"
                        Margin="6,0,0,0"
                        Width="28"
                        Height="28"
                        Click="SettingsButton_Click"
                        ToolTip="Preferences" />
            </Grid>

            <!-- Results List -->
            <ListBox x:Name="ResultsList"
                     Grid.Row="1"
                     Background="Transparent"
                     Foreground="White"
                     BorderThickness="0"
                     Margin="0,6,0,0"
                     VirtualizingPanel.ScrollUnit="Item"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ResultsList_MouseDoubleClick"
                     MouseMove="ResultsList_MouseMove"
                     MouseLeave="ResultsList_MouseLeave"
                     SelectionChanged="ResultsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="6,3" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Source App Icon -->
                                <Image Grid.Column="0"
                                       Width="18" Height="18"
                                       VerticalAlignment="Center"
                                       Source="{Binding SourceAppPath, Converter={StaticResource AppIconConverter}}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <!-- Content area: image thumbnail or text -->
                                <Grid Grid.Column="1" Margin="8,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Image: thumbnail preview -->
                                    <Image Grid.Column="0"
                                           Source="{Binding ThumbnailImage}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Left"
                                           MaxHeight="28"
                                           Visibility="{Binding HasImage, Converter={StaticResource ImageToVisibilityConverter}}" />

                                    <!-- Text: single-line preview -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Preview}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Visibility="{Binding HasImage, Converter={StaticResource TextToVisibilityConverter}}" />

                                    <!-- Pin indicator -->
                                    <TextBlock Grid.Column="1"
                                               Text="📌"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="0">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#0078D4" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#3D3D3D" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Detail Preview Panel (Maccy-style inline preview) -->
            <Border x:Name="DetailPanel"
                    Grid.Row="2"
                    Margin="0,4,0,0"
                    Padding="10"
                    Background="#1E1E1E"
                    BorderBrush="#444444"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,4,4"
                    MaxHeight="180"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- Text detail -->
                        <TextBlock x:Name="DetailText"
                                   Foreground="#CCCCCC"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <!-- Image detail -->
                        <Image x:Name="DetailImage"
                               Stretch="Uniform"
                               StretchDirection="Both"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="Collapsed" />
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="3" Margin="0,4,0,0" Padding="4,2" Background="#333333" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               x:Name="FooterText"
                               Foreground="#888888"
                               FontSize="11"/>
                    <TextBlock Grid.Column="1"
                               Foreground="#666666"
                               FontSize="10">
                        <Run Text="↵ Copy" />
                        <Run Text=" | " Foreground="#444444" />
                        <Run Text="⌥↵ Paste" Foreground="#666666" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>