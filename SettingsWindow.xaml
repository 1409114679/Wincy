<Window x:Class="Wincy.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wincy Settings"
        Width="480"
        Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2D2D2D"
        Foreground="White"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <Window.Resources>
        <Style x:Key="HotkeyLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="ActionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LangButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" Padding="4,2">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#0078D4"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title row: app icon + title + language -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="32" Height="32"
                   x:Name="AppTitleIcon"
                   Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="TitleLabel" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" Text="Settings"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="LangEN" Content="English"
                             Style="{StaticResource LangButtonStyle}"
                             Checked="Language_Checked" Tag="English"/>
                <RadioButton x:Name="LangCN" Content="中文"
                             Style="{StaticResource LangButtonStyle}"
                             Checked="Language_Checked" Tag="Chinese"/>
            </StackPanel>
        </Grid>

        <!-- Max history items -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MaxItemsLabel" Grid.Column="0"
                       Text="Max items: " Foreground="#AAA" FontSize="13"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="MaxItemsBox" Grid.Column="1"
                     Text="200" Foreground="White" CaretBrush="White"
                     Background="#3D3D3D" BorderThickness="0"
                     FontSize="13" Padding="4,2" TextAlignment="Center"
                     PreviewTextInput="MaxItems_PreviewTextInput"/>
        </Grid>

        <!-- Subtitle + recording hint -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock x:Name="ShortcutHeader" FontSize="14" FontWeight="SemiBold" Foreground="#AAA"
                       Text="Keyboard Shortcuts"/>
            <TextBlock x:Name="RecordingHint"
                       FontSize="11" Foreground="#F0A030" Margin="0,4,0,0"
                       Visibility="Collapsed">
                Recording...
            </TextBlock>
        </StackPanel>

        <!-- Hotkey list -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="HotkeyListPanel">
                <Grid x:Name="Row_ShowHotkey" MouseLeftButtonDown="HotkeyRow_Click"
                      Tag="ShowHotkey" Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="Lbl_ShowHideText"
                               Style="{StaticResource ActionLabelStyle}" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="1" x:Name="Lbl_ShowHotkey"
                               MouseDown="HotkeyLabel_Click" Tag="ShowHotkey"
                               Style="{StaticResource HotkeyLabelStyle}"/>
                </Grid>
                <Separator Background="#444" Margin="0,2"/>
                <Grid x:Name="Row_CopyHotkey" MouseLeftButtonDown="HotkeyRow_Click"
                      Tag="CopyHotkey" Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="Lbl_CopyText"
                               Style="{StaticResource ActionLabelStyle}" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="1" x:Name="Lbl_CopyHotkey"
                               MouseDown="HotkeyLabel_Click" Tag="CopyHotkey"
                               Style="{StaticResource HotkeyLabelStyle}"/>
                </Grid>
                <Separator Background="#444" Margin="0,2"/>
                <Grid x:Name="Row_PasteHotkey" MouseLeftButtonDown="HotkeyRow_Click"
                      Tag="PasteHotkey" Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="Lbl_PasteText"
                               Style="{StaticResource ActionLabelStyle}" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="1" x:Name="Lbl_PasteHotkey"
                               MouseDown="HotkeyLabel_Click" Tag="PasteHotkey"
                               Style="{StaticResource HotkeyLabelStyle}"/>
                </Grid>
                <Separator Background="#444" Margin="0,2"/>
                <Grid x:Name="Row_DeleteHotkey" MouseLeftButtonDown="HotkeyRow_Click"
                      Tag="DeleteHotkey" Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="Lbl_DeleteText"
                               Style="{StaticResource ActionLabelStyle}" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="1" x:Name="Lbl_DeleteHotkey"
                               MouseDown="HotkeyLabel_Click" Tag="DeleteHotkey"
                               Style="{StaticResource HotkeyLabelStyle}"/>
                </Grid>
                <Separator Background="#444" Margin="0,2"/>
                <Grid x:Name="Row_PinHotkey" MouseLeftButtonDown="HotkeyRow_Click"
                      Tag="PinHotkey" Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="Lbl_PinText"
                               Style="{StaticResource ActionLabelStyle}" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="1" x:Name="Lbl_PinHotkey"
                               MouseDown="HotkeyLabel_Click" Tag="PinHotkey"
                               Style="{StaticResource HotkeyLabelStyle}"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox x:Name="AutoStartCheck" Grid.Row="0"
                      Foreground="#AAA" FontSize="12" Margin="0,0,0,6"
                      Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"
                      Content="Launch at startup"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HintText" Grid.Column="0"
                           VerticalAlignment="Center" FontSize="11" Foreground="#666"/>
                <Button x:Name="ResetBtn" Grid.Column="1"
                        Background="#444" Foreground="#CCC"
                        BorderThickness="1" BorderBrush="#555"
                        Padding="10,6" FontSize="12" Cursor="Hand"
                        Click="ResetDefaults_Click" Margin="0,0,10,0"/>
                <Button x:Name="DoneBtn" Grid.Column="2"
                        Background="#0078D4" Foreground="White"
                        BorderThickness="0" Padding="16,6" FontSize="12" FontWeight="Bold"
                        Cursor="Hand" Click="Done_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>