<Window x:Class="Wincy.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wincy Preferences"
        Width="480"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2D2D2D"
        Foreground="White"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <Window.Resources>
        <Style x:Key="HotkeyLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="RecordingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="ActionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HotkeyRowStyle" TargetType="Grid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="0,0,0,12">Preferences</TextBlock>

        <!-- Subtitle + recording hint -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#AAA">Keyboard Shortcuts</TextBlock>
            <TextBlock x:Name="RecordingHint"
                       FontSize="11"
                       Foreground="#F0A030"
                       Margin="0,4,0,0"
                       Visibility="Collapsed">
                ⏺ Recording: Press your key combination... (Esc to cancel)
            </TextBlock>
        </StackPanel>

        <!-- Hotkey list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="HotkeyListPanel">

                <!-- Row 0: Show/Hide Wincy -->
                <Grid x:Name="Row_ShowHotkey"
                      MouseLeftButtonDown="HotkeyRow_Click"
                      Tag="ShowHotkey"
                      Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ActionLabelStyle}"
                               Text="Show/Hide Wincy" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="1" x:Name="Lbl_ShowHotkey"
                               Text="Ctrl+;" MouseDown="HotkeyLabel_Click"
                               Tag="ShowHotkey"
                               Style="{StaticResource HotkeyLabelStyle}"/>
                </Grid>

                <Separator Background="#444" Margin="0,2"/>

                <!-- Row 1: Select and Copy -->
                <Grid x:Name="Row_CopyHotkey"
                      MouseLeftButtonDown="HotkeyRow_Click"
                      Tag="CopyHotkey"
                      Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ActionLabelStyle}"
                               Text="Select and Copy" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="1" x:Name="Lbl_CopyHotkey"
                               Text="Enter" MouseDown="HotkeyLabel_Click"
                               Tag="CopyHotkey"
                               Style="{StaticResource HotkeyLabelStyle}"/>
                </Grid>

                <Separator Background="#444" Margin="0,2"/>

                <!-- Row 2: Select and Paste -->
                <Grid x:Name="Row_PasteHotkey"
                      MouseLeftButtonDown="HotkeyRow_Click"
                      Tag="PasteHotkey"
                      Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ActionLabelStyle}"
                               Text="Select and Paste" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="1" x:Name="Lbl_PasteHotkey"
                               Text="Alt+Enter" MouseDown="HotkeyLabel_Click"
                               Tag="PasteHotkey"
                               Style="{StaticResource HotkeyLabelStyle}"/>
                </Grid>

                <Separator Background="#444" Margin="0,2"/>

                <!-- Row 3: Delete Item -->
                <Grid x:Name="Row_DeleteHotkey"
                      MouseLeftButtonDown="HotkeyRow_Click"
                      Tag="DeleteHotkey"
                      Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ActionLabelStyle}"
                               Text="Delete Item" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="1" x:Name="Lbl_DeleteHotkey"
                               Text="Alt+Delete" MouseDown="HotkeyLabel_Click"
                               Tag="DeleteHotkey"
                               Style="{StaticResource HotkeyLabelStyle}"/>
                </Grid>

                <Separator Background="#444" Margin="0,2"/>

                <!-- Row 4: Pin/Unpin -->
                <Grid x:Name="Row_PinHotkey"
                      MouseLeftButtonDown="HotkeyRow_Click"
                      Tag="PinHotkey"
                      Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ActionLabelStyle}"
                               Text="Pin/Unpin" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="1" x:Name="Lbl_PinHotkey"
                               Text="Alt+P" MouseDown="HotkeyLabel_Click"
                               Tag="PinHotkey"
                               Style="{StaticResource HotkeyLabelStyle}"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom buttons -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="#666">
                Click a shortcut, then press your new keys
            </TextBlock>
            <Button Grid.Column="1" Content="Reset to Defaults"
                    Background="#444" Foreground="#CCC"
                    BorderThickness="1" BorderBrush="#555"
                    Padding="10,6" FontSize="12"
                    Cursor="Hand"
                    Click="ResetDefaults_Click"
                    Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="Done"
                    Background="#0078D4" Foreground="White"
                    BorderThickness="0"
                    Padding="16,6" FontSize="12" FontWeight="Bold"
                    Cursor="Hand"
                    Click="Done_Click"/>
        </Grid>
    </Grid>
</Window>